{
  "manifest_version": 3,
  "name": "YouTube Likes Sync",
  "version": "0.1.0",
  "description": "Connect your YouTube Music account to the local YouTube Likes Sync Windows app.",
  "key": "",
  "minimum_chrome_version": "105",
  "permissions": [
    "activeTab",
    "webRequest",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Connect YouTube Music",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "incognito": "not_allowed",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
